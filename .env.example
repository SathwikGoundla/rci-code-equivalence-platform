# Environment Configuration Example
# Copy to .env and modify for your environment
# NEVER commit .env to version control

# ─── Application ───────────────────────────────────────────────────────────────
APP_NAME="RCI Code Equivalence Platform"
APP_VERSION="0.1.0"
APP_ENV="development"          # development | production
DEBUG=true

# ─── Server ────────────────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8000

# ─── Database ──────────────────────────────────────────────────────────────────
# SQLite database path (relative to backend directory)
DATABASE_URL="sqlite+aiosqlite:///./rci_platform.db"

# ─── Security ──────────────────────────────────────────────────────────────────
# NEVER log source code content
REDACT_SOURCE_CODE_IN_LOGS=true
# Maximum source file size in bytes (5MB default)
MAX_SOURCE_FILE_SIZE=5242880

# ─── Execution Engine ──────────────────────────────────────────────────────────
# Timeout in seconds for subprocess execution
EXECUTION_TIMEOUT=30
# Temporary directory for compilation/execution (defaults to system temp)
EXECUTION_TMP_DIR=""
# Maximum memory for child processes (MB) — advisory only on Windows
MAX_PROCESS_MEMORY_MB=512

# ─── Compiler Paths (optional overrides — auto-detected if empty) ───────────────
C_COMPILER_PATH=""         # e.g. C:/msys64/mingw64/bin/gcc.exe
FORTRAN_COMPILER_PATH=""   # e.g. C:/msys64/mingw64/bin/gfortran.exe

# ─── Local AI (optional) ───────────────────────────────────────────────────────
LOCAL_AI_ENABLED=false
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="codellama"

# ─── Frontend ──────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# ─── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL="INFO"           # DEBUG | INFO | WARNING | ERROR
LOG_FILE="logs/app.log"
